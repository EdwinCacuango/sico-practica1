# Copiar a .env y rellenar despues de arrancar el hub (http://localhost:8090)
# KEY: clave publica del hub (Add System -> "Public Key", o Settings -> Tokens & Fingerprints)
BESZEL_KEY=
# TOKEN: token de cada sistema (Add System) o el mismo universal token en ambos
BESZEL_TOKEN_DMZ1=
BESZEL_TOKEN_DMZ2=
